# Copy values into Vercel → Project → Settings → Environment Variables
# Full walkthrough: REVOLUT_SETUP.md

REVOLUT_ENV=production
REVOLUT_CLIENT_ID=
REVOLUT_PRIVATE_KEY=
REVOLUT_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/revolut/oauth/callback
REVOLUT_JWT_ISS=YOUR_VERCEL_DOMAIN
REVOLUT_APP_SECRET=
REVOLUT_REFRESH_TOKEN=

# Clerk (Next.js) — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → Data API + API Keys (publishable)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias if you prefer the legacy anon key name:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chief of Staff (OpenAI) — server only
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model override (default gpt-4.1)
# COS_OPENAI_MODEL=gpt-4.1

# Mentor still uses Anthropic Claude
ANTHROPIC_API_KEY=

# Chief of Staff → Slack briefs (pick ONE mode)
# Target channel: #daily-briefs → C0BNZGVQZSA
#
# Easiest for a channel: Incoming Webhook
# 1) Slack → Apps → Incoming Webhooks → Add to #daily-briefs
# 2) Paste URL below
# SLACK_COS_WEBHOOK_URL=https://hooks.slack.com/services/...
#
# Or Bot token (also works for DMs):
# 1) Create a Slack app with chat:write
# 2) Install to workspace, copy Bot User OAuth Token
# 3) Invite the bot to #daily-briefs (/invite @YourBot)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_COS_CHANNEL_ID=C0BNZGVQZSA

# Cron briefs when the app is closed (Vercel Cron + service role)
# CRON_SECRET=long-random-string
# SUPABASE_SERVICE_ROLE_KEY=...
# COS_OWNER_USER_ID=your_clerk_user_id
