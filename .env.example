# Copy values into Vercel → Project → Settings → Environment Variables
# Full walkthrough: REVOLUT_SETUP.md

REVOLUT_ENV=production
REVOLUT_CLIENT_ID=
REVOLUT_PRIVATE_KEY=
REVOLUT_REDIRECT_URI=https://YOUR_VERCEL_DOMAIN/api/revolut/oauth/callback
REVOLUT_JWT_ISS=YOUR_VERCEL_DOMAIN
REVOLUT_APP_SECRET=
REVOLUT_REFRESH_TOKEN=

# Clerk (Next.js) — Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → Data API + API Keys (publishable)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional alias if you prefer the legacy anon key name:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — server only (Mentor)
# Get a key at https://platform.openai.com/api-keys
# After swapping Vercel/GitHub accounts, re-add this on the NEW Vercel project
# (Production + Preview). Env vars do not move with the repo link.
OPENAI_API_KEY=
# Optional model override (default gpt-4.1)
# MENTOR_OPENAI_MODEL=gpt-4.1

# Optional — signs the Revolut OAuth `state` value (CSRF protection).
# Falls back to REVOLUT_APP_SECRET, then CLERK_SECRET_KEY, if unset.
# REVOLUT_OAUTH_STATE_SECRET=
